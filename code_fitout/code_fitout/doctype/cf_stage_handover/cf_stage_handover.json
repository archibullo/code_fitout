    {
      "role": "CF Fitout Viewer",
      "permlevel": 0,
      "read": 1,
      "select": 1,
      "report": 1,
      "print": 1
    },
    {
      "role": "CF Fitout Editor",
      "permlevel": 0,
      "read": 1,
      "select": 1,
      "report": 1,
      "print": 1,
      "create": 1,
      "write": 1
    },
    {
      "role": "CF Fitout Approver",
      "permlevel": 0,
      "read": 1,
      "select": 1,
      "report": 1,
      "print": 1,
      "create": 1,
      "write": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1
    },
    {
      "role": "System Manager",
      "permlevel": 0,
      "read": 1,
      "select": 1,
      "report": 1,
      "print": 1,
      "create": 1,
      "write": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1
    }
  ],
  "states": [],
  "sort_field": "modified",
  "sort_order": "DESC",
  "naming_rule": "Expression",
  "autoname": "CF-HO-.#####",
  "title_field": "project"
}
