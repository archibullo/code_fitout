{
  "doctype": "DocType",
  "name": "CF Supervisor Assignment",
  "module": "Code Fitout",
  "custom": 0,
  "istable": 0,
  "is_submittable": 1,
  "track_changes": 1,
  "engine": "InnoDB",
  "field_order": [
    "assignment_details",
    "project",
    "supervisor",
    "mode",
    "column_details",
    "start_date",
    "end_date",
    "supervision_agreement",
    "schedule_section",
    "resident_days_per_week",
    "visit_plan",
    "visits_per_month",
    "schedule_notes",
    "fees_section",
    "fee_basis",
    "monthly_fee",
    "per_visit_fee",
    "fixed_fee",
    "fee_payer",
    "scope",
    "notes",
    "amended_from"
  ],
  "fields": [
    {
      "fieldname": "assignment_details",
      "fieldtype": "Section Break",
      "label": "Site Supervision Assignment"
    },
    {
      "fieldname": "project",
      "fieldtype": "Link",
      "label": "Apartment / Project",
      "options": "Project",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "supervisor",
      "fieldtype": "Link",
      "label": "Supervisor",
      "options": "CF Supervisor",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "mode",
      "fieldtype": "Select",
      "label": "Supervision Mode",
      "options": "Resident\nVisits",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "column_details",
      "fieldtype": "Column Break",
      "label": ""
    },
    {
      "fieldname": "start_date",
      "fieldtype": "Date",
      "label": "Assignment Start Date",
      "reqd": 1
    },
    {
      "fieldname": "end_date",
      "fieldtype": "Date",
      "label": "Assignment End Date (optional)"
    },
    {
      "fieldname": "supervision_agreement",
      "fieldtype": "Link",
      "label": "Owner Supervision Agreement (optional)",
      "options": "CF Supervision Agreement"
    },
    {
      "fieldname": "schedule_section",
      "fieldtype": "Section Break",
      "label": "Attendance / Visit Plan"
    },
    {
      "fieldname": "resident_days_per_week",
      "fieldtype": "Int",
      "label": "Resident: Expected Days per Week",
      "description": "Reference target; actual attendance is captured in submitted daily site logs."
    },
    {
      "fieldname": "visit_plan",
      "fieldtype": "Select",
      "label": "Visits: Scheduling",
      "options": "Scheduled\nOn Demand",
      "default": "Scheduled"
    },
    {
      "fieldname": "visits_per_month",
      "fieldtype": "Int",
      "label": "Visits: Planned Visits per Month",
      "description": "Planning target, not automatically generated appointments."
    },
    {
      "fieldname": "schedule_notes",
      "fieldtype": "Small Text",
      "label": "Expected Working Days / Visit Times"
    },
    {
      "fieldname": "fees_section",
      "fieldtype": "Section Break",
      "label": "Supervisor Compensation (Operational Only)"
    },
    {
      "fieldname": "fee_basis",
      "fieldtype": "Select",
      "label": "Fee Basis",
      "reqd": 1,
      "options": "No Separate Fee\nMonthly Fee\nPer Visit\nFixed Fee",
      "default": "No Separate Fee"
    },
    {
      "fieldname": "monthly_fee",
      "fieldtype": "Currency",
      "label": "Monthly Supervisor Fee (EGP)",
      "options": "EGP",
      "non_negative": 1
    },
    {
      "fieldname": "per_visit_fee",
      "fieldtype": "Currency",
      "label": "Fee per Completed Visit (EGP)",
      "options": "EGP",
      "non_negative": 1
    },
    {
      "fieldname": "fixed_fee",
      "fieldtype": "Currency",
      "label": "Fixed Assignment Fee (EGP)",
      "options": "EGP",
      "non_negative": 1
    },
    {
      "fieldname": "fee_payer",
      "fieldtype": "Select",
      "label": "Responsible for Supervisor Compensation",
      "options": "Property Owner\nC.O.D.E.\nTo Be Determined",
      "default": "To Be Determined",
      "reqd": 1
    },
    {
      "fieldname": "scope",
      "fieldtype": "Small Text",
      "label": "Scope / Responsibilities",
      "reqd": 1
    },
    {
      "fieldname": "notes",
      "fieldtype": "Small Text",
      "label": "Terms / Reporting Requirements"
    },
    {
      "fieldname": "amended_from",
      "fieldtype": "Link",
      "label": "Amended From",
      "options": "CF Supervisor Assignment",
      "read_only": 1,
      "no_copy": 1
    }
  ],
  "permissions": [
    {
      "role": "CF Fitout Viewer",
      "permlevel": 0,
      "read": 1,
      "select": 1,
      "report": 1
    },
    {
      "role": "CF Fitout Editor",
      "permlevel": 0,
      "read": 1,
      "select": 1,
      "report": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "CF Fitout Approver",
      "permlevel": 0,
      "read": 1,
      "select": 1,
      "report": 1,
      "write": 1,
      "create": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1
    },
    {
      "role": "System Manager",
      "permlevel": 0,
      "read": 1,
      "select": 1,
      "report": 1,
      "write": 1,
      "create": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1
    }
  ],
  "states": [],
  "naming_rule": "Expression",
  "autoname": "CF-ASN-.#####",
  "title_field": "project",
  "sort_field": "modified",
  "sort_order": "DESC"
}
